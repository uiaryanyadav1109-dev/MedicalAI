{
  "expo": {
    "name": "Medical AI",
    "slug": "medical-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medicalai.app"
    },
    "android": {
      "package": "com.medicalai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-notifications",
      "expo-asset",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "apiBaseUrl": "http://10.149.6.231:3000/api",
      "productionApiUrl": "https://medicalai.internal/api",
      "eas": {
        "projectId": "b1cfb70b-8434-4172-9383-0b210d1c8f05"
      }
    },
    "owner": "aryan_yadav-dev"
  }
}
